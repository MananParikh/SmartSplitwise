{
  "manifest_version": 3,
  "name": "SmartSplitwise",
  "version": "1.0.0",
  "description": "Read any store receipt on screen, assign items to people, split tax proportionally, and get a clean who-owes-whom summary for Splitwise.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartSplitwise",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
